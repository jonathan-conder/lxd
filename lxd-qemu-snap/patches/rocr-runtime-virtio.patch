--- a/projects/rocr-runtime/libhsakmt/src/virtio/hsakmt_virtio_device.c
+++ b/projects/rocr-runtime/libhsakmt/src/virtio/hsakmt_virtio_device.c
@@ -24,10 +24,74 @@
 
 #include "hsakmt_virtio_device.h"
 
+int vhsakmt_require_wire_features(vhsakmt_device_handle dev, uint64_t features) {
+  int ret = 0;
+
+  pthread_mutex_lock(&dev->vhsakmt_mutex);
+  if (!dev->wire_features_valid) {
+    struct vhsakmt_ccmd_query_info_req req = {
+        .hdr = VHSAKMT_CCMD(QUERY_INFO, sizeof(req)),
+        .type = VHSAKMT_CCMD_QUERY_OPEN_KFD,
+        .open_kfd_args.cur_vm_start = dev->vm_start,
+    };
+    struct vhsakmt_ccmd_query_info_rsp* rsp = vhsakmt_alloc_rsp(dev, &req.hdr, sizeof(*rsp));
+    if (!rsp) {
+      ret = -ENOMEM;
+    } else {
+      rsp->ret = -EOPNOTSUPP;
+      memset(&rsp->open_kfd_rsp, 0, sizeof(rsp->open_kfd_rsp));
+      ret = vhsakmt_execbuf_cpu(dev, &req.hdr, __FUNCTION__);
+      if (!ret) ret = rsp->ret;
+      if (!ret && rsp->hdr.len < sizeof(*rsp)) ret = -EOPNOTSUPP;
+      if (!ret) {
+        dev->wire_features = rsp->open_kfd_rsp.features;
+        dev->wire_features_valid = true;
+      }
+    }
+  }
+  if (!ret && (dev->wire_features & features) != features) ret = -EOPNOTSUPP;
+  pthread_mutex_unlock(&dev->vhsakmt_mutex);
+  return ret;
+}
+
+int vhsakmt_require_wire_pointers(vhsakmt_device_handle dev) {
+  return vhsakmt_require_wire_features(dev, VHSAKMT_WIRE_FEATURE_POINTERS_V2);
+}
+
 int vhsakmt_execbuf_cpu(vhsakmt_device_handle dev, struct vhsakmt_ccmd_req* req, const char* from) {
   return virtio_gpu_exec_cmd(dev->vgdev, req, true);
 }
 
+int vhsakmt_execbuf_rsp(vhsakmt_device_handle dev, struct vhsakmt_ccmd_req* req,
+                       const struct vhsakmt_ccmd_rsp* rsp, uint32_t size, const char* from) {
+  int32_t status;
+  if (!rsp || size < sizeof(*rsp) + sizeof(status) || size > UINT32_MAX - 7)
+    return -EINVAL;
+
+  int ret = vhsakmt_execbuf_cpu(dev, req, from);
+  if (ret) return ret;
+  if (rsp->len < size || rsp->len > VHSA_ALIGN_UP(size, 8)) return -EPROTO;
+  memcpy(&status, (const char*)rsp + sizeof(*rsp), sizeof(status));
+  return status;
+}
+
 void* vhsakmt_alloc_rsp(vhsakmt_device_handle dev, struct vhsakmt_ccmd_req* req, uint32_t sz) {
-  return virtio_gpu_alloc_rsp(dev->vgdev, req, sz);
+  _Static_assert(offsetof(struct vhsakmt_ccmd_query_info_rsp, ret) == sizeof(struct vhsakmt_ccmd_rsp), "query status layout");
+  _Static_assert(offsetof(struct vhsakmt_ccmd_event_rsp, ret) == sizeof(struct vhsakmt_ccmd_rsp), "event status layout");
+  _Static_assert(offsetof(struct vhsakmt_ccmd_memory_rsp, ret) == sizeof(struct vhsakmt_ccmd_rsp), "memory status layout");
+  _Static_assert(offsetof(struct vhsakmt_ccmd_queue_rsp, ret) == sizeof(struct vhsakmt_ccmd_rsp), "queue status layout");
+  _Static_assert(offsetof(struct vhsakmt_ccmd_gl_inter_rsp, ret) == sizeof(struct vhsakmt_ccmd_rsp), "graphics status layout");
+
+  const int32_t failure = HSAKMT_STATUS_ERROR;
+  if (sz < sizeof(struct vhsakmt_ccmd_rsp) + sizeof(failure) || sz > UINT32_MAX - 7)
+    return NULL;
+  uint32_t size = VHSA_ALIGN_UP(sz, 8);
+  if (!dev->vgdev->rsp_mem || size > dev->vgdev->rsp_mem_len) return NULL;
+
+  struct vhsakmt_ccmd_rsp* rsp = virtio_gpu_alloc_rsp(dev->vgdev, req, size);
+  if (!rsp) return NULL;
+  memset(rsp, 0, size);
+  rsp->len = size;
+  memcpy((char*)rsp + sizeof(*rsp), &failure, sizeof(failure));
+  return rsp;
 }
